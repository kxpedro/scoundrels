# Banco (dev: docker compose up -d; produção: Neon via integração da Vercel)
DATABASE_URL=postgres://scoundrels:scoundrels@localhost:5433/scoundrels

# Better Auth — gere com: npx @better-auth/cli secret  (ou openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# OAuth (opcional em dev; o provedor só aparece se as duas chaves existirem)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Magic link via Resend (sem chave, o link é impresso no terminal em dev)
RESEND_API_KEY=
EMAIL_FROM="Scoundrels <login@scoundrels.gg>"

# IGDB (Twitch) — entrega 2
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
